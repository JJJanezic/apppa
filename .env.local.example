# Supabase – Werte aus dem Dashboard: Project Settings → API Keys
# Entwicklung: Projekt „apppa“; Produktion: eigenes Projekt (nur in Vercel hinterlegen)

# Projektadresse (öffentlich)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Öffentlicher Schlüssel (Publishable key, beginnt mit sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Geheimer Schlüssel (Secret key, beginnt mit sb_secret_) – NUR serverseitig, nie mit NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_your_key_here

BREVO_API_KEY=xkeysib-your_key_here
BREVO_SENDER_EMAIL=no-reply@apppa.at